# Server
PORT=8080
HOST=0.0.0.0

# Security — REQUIRED: 32+ character random string
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=

# Database
DB_PATH=./data/taofff.db

# Arbitrage Parameters
MIN_NET_APR_PCT=5.0
TRADING_FEE_PCT=0.05
SLIPPAGE_PCT=0.02
DEFAULT_LEVERAGE=1
BORROW_RATE_DAILY=0.0001
REBALANCE_TIMES_PER_YEAR=12
STALENESS_THRESHOLD_SECONDS=120

# WebSocket
WS_BROADCAST_INTERVAL_SECONDS=2
WS_FULL_SNAPSHOT_INTERVAL_SECONDS=30

# Frontend (optional): override ws endpoint
# VITE_WS_URL=ws://localhost:5173/ws

# Exchange-specific
BINANCE_SETTLEMENT_HOURS=8
OKX_SETTLEMENT_HOURS=8
BYBIT_SETTLEMENT_HOURS=8
HYPERLIQUID_SETTLEMENT_HOURS=1
HYPERLIQUID_POLL_INTERVAL_SECONDS=30

# Cleanup
RETENTION_DAYS_RATES=30
RETENTION_DAYS_TRADES=90
RETENTION_DAYS_METRICS=14

# Optional: disable problematic exchanges in specific regions
# Example: DISABLED_EXCHANGES=bybit
DISABLED_EXCHANGES=

# Optional: Bybit API host override (when default api.bybit.com is geo-blocked)
# Example: BYBIT_API_HOST=https://api.bytick.com
BYBIT_API_HOST=
